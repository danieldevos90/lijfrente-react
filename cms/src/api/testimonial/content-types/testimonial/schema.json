{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Customer testimonials and reviews"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "company": {
      "type": "string",
      "required": true
    },
    "text": {
      "type": "text",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5
    },
    "siteId": {
      "type": "string",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sector": {
      "type": "string",
      "description": "Sector slug (e.g., 'horeca', 'retail', 'transport') - optional for sector-specific testimonials"
    },
    "role": {
      "type": "string",
      "description": "Job title or role of the testimonial author"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}




