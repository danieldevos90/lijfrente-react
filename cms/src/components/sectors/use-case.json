{
  "collectionName": "components_sectors_use_cases",
  "info": {
    "name": "use-case",
    "displayName": "Use Case",
    "icon": "star",
    "description": "A use case or purpose for financing in a sector"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "iconPath": {
      "type": "string",
      "description": "Path to icon SVG (e.g., '/icons/SVG/finance/wallet.svg')"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Image for the use case (takes precedence over iconPath)"
    },
    "color": {
      "type": "string",
      "default": "#fff2b2",
      "description": "Background color for the card"
    },
    "textColor": {
      "type": "string",
      "default": "#1e2021",
      "description": "Text color for the card"
    },
    "buttonLabel": {
      "type": "string",
      "description": "Optional button label for this use case"
    },
    "buttonHref": {
      "type": "string",
      "default": "/lead",
      "description": "Optional button link"
    }
  }
}
