{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "icon": "cursor",
    "description": "Reusable button component"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "outline", "text"],
      "default": "primary"
    },
    "size": {
      "type": "enumeration",
      "enum": ["small", "medium", "large"],
      "default": "medium"
    },
    "icon": {
      "type": "string",
      "description": "Icon path or name"
    }
  }
}

