{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "x-vercel-protection-bypass", "value": "${VERCEL_PROTECTION_BYPASS}" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/password",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}


